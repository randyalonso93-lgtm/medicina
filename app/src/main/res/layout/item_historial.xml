<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/md_theme_surface_container"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/md_theme_outline"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <View
            android:id="@+id/indicadorToma"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@color/stock_ok" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNombreHis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Ibuprofeno"
                android:textColor="@color/md_theme_on_surface"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvFechaHis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Hoy 08:30"
                android:textColor="@color/md_theme_on_surface_variant"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvEstadoHis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tomado"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>